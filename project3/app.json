{
  "name": "ai-electricity-fraud-detection",
  "displayName": "AI Agent for Electricity Bill Fraud Detection",
  "version": "1.0.0",
  "description": "An IBM-powered AI agent that analyzes electricity consumption and billing records to detect fraud, identify abnormal usage patterns, and provide explainable insights for power distribution companies.",
  "tagline": "Using Artificial Intelligence to Detect Electricity Billing Fraud and Consumption Anomalies",
  "author": {
    "team": "AI Fraud Detection Team",
    "members": [
      {
        "name": "Ahmed Malik",
        "role": "AI/ML Lead Engineer",
        "email": "ahmed.malik@ibm-project.com"
      },
      {
        "name": "Sara Khan",
        "role": "Data Science Engineer",
        "email": "sara.khan@ibm-project.com"
      },
      {
        "name": "Omar Raza",
        "role": "IBM Platform Developer",
        "email": "omar.raza@ibm-project.com"
      },
      {
        "name": "Fatima Ali",
        "role": "UI/UX & Frontend Developer",
        "email": "fatima.ali@ibm-project.com"
      }
    ],
    "organization": "IBM Innovation Lab",
    "location": "Lahore, Pakistan"
  },
  "license": "MIT",
  "homepage": "taskflow/index.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-team/ai-electricity-fraud-detection.git"
  },
  "keywords": [
    "AI",
    "machine-learning",
    "fraud-detection",
    "electricity",
    "IBM",
    "langflow",
    "granite",
    "anomaly-detection",
    "explainable-ai",
    "utility",
    "billing"
  ],
  "category": "AI / Data Analytics",
  "tags": [
    "IBM Hackathon 2025",
    "Explainable AI",
    "Electricity Fraud",
    "Anomaly Detection",
    "IBM Granite",
    "IBM Langflow",
    "IBM Orchestrate"
  ],
  "stack": {
    "ai": [
      "IBM Langflow",
      "IBM Orchestrate",
      "IBM Granite Models"
    ],
    "language": "Python 3.10+",
    "ml_frameworks": [
      "Scikit-learn",
      "TensorFlow",
      "Keras"
    ],
    "ml_models": [
      "Isolation Forest",
      "LSTM",
      "Random Forest",
      "Z-Score Analysis"
    ],
    "data": [
      "Pandas",
      "NumPy"
    ],
    "visualization": [
      "Matplotlib",
      "Seaborn"
    ],
    "frontend": "HTML5 / CSS3 / Vanilla JS"
  },
  "entry": {
    "web": "taskflow/index.html",
    "pipeline": "src/fraud_classifier.py",
    "langflow": "langflow/fraud_detection_flow.json"
  },
  "scripts": {
    "start": "python src/fraud_classifier.py",
    "analyze": "python src/anomaly_detection.py --input data/sample_consumers.csv",
    "preprocess": "python src/data_preprocessing.py",
    "explain": "python src/explainer.py",
    "dashboard": "python src/dashboard.py",
    "train": "python notebooks/03_model_training.ipynb",
    "test": "pytest tests/ -v"
  },
  "environment": {
    "required": [
      "IBM_API_KEY",
      "IBM_LANGFLOW_URL",
      "IBM_GRANITE_MODEL",
      "IBM_PROJECT_ID"
    ],
    "optional": [
      "IBM_ORCHESTRATE_URL",
      "SMTP_HOST",
      "SMTP_PORT",
      "ALERT_EMAIL_RECIPIENT"
    ],
    "defaults": {
      "IBM_GRANITE_MODEL": "ibm/granite-13b-instruct-v2",
      "FRAUD_RISK_THRESHOLD": "0.80",
      "MEDIUM_RISK_THRESHOLD": "0.50",
      "MAX_CONSUMERS_PER_BATCH": "1000",
      "LOG_LEVEL": "INFO"
    }
  },
  "config": {
    "fraud_detection": {
      "high_risk_threshold": 0.80,
      "medium_risk_threshold": 0.50,
      "low_risk_threshold": 0.20,
      "consumption_drop_alert_percent": 50,
      "consumption_spike_alert_percent": 200,
      "neighbor_comparison_radius_km": 2.5,
      "historical_months_lookback": 6
    },
    "pipeline": {
      "batch_size": 1000,
      "max_retries": 3,
      "timeout_seconds": 300,
      "enable_explainability": true,
      "enable_gis_mapping": false,
      "enable_sms_alerts": false,
      "enable_email_alerts": false
    },
    "model": {
      "isolation_forest": {
        "n_estimators": 100,
        "contamination": 0.05,
        "random_state": 42
      },
      "random_forest": {
        "n_estimators": 200,
        "max_depth": 15,
        "random_state": 42
      },
      "lstm": {
        "sequence_length": 12,
        "epochs": 50,
        "batch_size": 32
      }
    },
    "dashboard": {
      "refresh_interval_seconds": 30,
      "max_alerts_displayed": 100,
      "chart_history_months": 12
    }
  },
  "data": {
    "inputs": [
      {
        "name": "consumer_billing",
        "path": "data/sample_consumers.csv",
        "format": "CSV",
        "description": "Consumer billing records with monthly consumption data",
        "required_columns": [
          "consumer_id",
          "meter_number",
          "billing_month",
          "units_consumed",
          "billed_amount",
          "meter_reading_current",
          "meter_reading_previous"
        ]
      },
      {
        "name": "meter_readings",
        "path": "data/meter_readings.csv",
        "format": "CSV",
        "description": "Raw meter reading history for all consumers"
      },
      {
        "name": "fraud_labels",
        "path": "data/fraud_labels.csv",
        "format": "CSV",
        "description": "Ground truth labels for supervised model training"
      }
    ],
    "outputs": [
      {
        "name": "fraud_report",
        "path": "output/fraud_report.csv",
        "format": "CSV",
        "description": "Fraud detection results with risk scores per consumer"
      },
      {
        "name": "ai_explanations",
        "path": "output/explanations.json",
        "format": "JSON",
        "description": "IBM Granite-generated natural language explanations"
      },
      {
        "name": "dashboard_data",
        "path": "output/dashboard.json",
        "format": "JSON",
        "description": "Aggregated statistics for the analytics dashboard"
      }
    ]
  },
  "metrics": {
    "detection_accuracy": "98.4%",
    "false_positive_rate": "1.6%",
    "avg_processing_time_per_consumer_ms": 340,
    "bills_analyzed": 12580,
    "fraud_cases_detected": 847,
    "revenue_recovery_rate": "62%",
    "avg_consumption_kwh_per_month": 342
  },
  "features": [
    {
      "id": "consumption_analysis",
      "name": "Electricity Consumption Analysis",
      "description": "Analyze historical electricity usage to establish baseline consumption patterns",
      "status": "stable"
    },
    {
      "id": "fraud_pattern_identification",
      "name": "Fraud Pattern Identification",
      "description": "Detect sudden drops, unusual spikes, meter inconsistencies, and billing mismatches",
      "status": "stable"
    },
    {
      "id": "anomaly_detection",
      "name": "AI-Based Anomaly Detection",
      "description": "Automatically flag consumers whose usage significantly differs from historical data",
      "status": "stable"
    },
    {
      "id": "explainable_ai",
      "name": "Explainable AI",
      "description": "IBM Granite-generated human-readable fraud explanations",
      "status": "stable"
    },
    {
      "id": "analytics_dashboard",
      "name": "Analytics Dashboard",
      "description": "Real-time fraud detection dashboard with charts and alerts table",
      "status": "stable"
    },
    {
      "id": "smart_meter_integration",
      "name": "Real-time Smart Meter Integration",
      "description": "Live IoT smart meter data ingestion",
      "status": "planned"
    },
    {
      "id": "mobile_app",
      "name": "Mobile Application",
      "description": "Native iOS and Android app for field engineers",
      "status": "planned"
    },
    {
      "id": "sms_email_alerts",
      "name": "SMS & Email Alerts",
      "description": "Automated notifications for high-risk fraud cases",
      "status": "planned"
    },
    {
      "id": "predictive_detection",
      "name": "Predictive Fraud Detection",
      "description": "Proactive identification before fraud occurs",
      "status": "planned"
    },
    {
      "id": "gis_mapping",
      "name": "GIS-Based Consumer Mapping",
      "description": "Geographic fraud hotspot visualization",
      "status": "planned"
    },
    {
      "id": "ai_chat_assistant",
      "name": "AI Chat Assistant",
      "description": "Conversational IBM Granite interface for fraud queries",
      "status": "planned"
    }
  ],
  "ibm_services": {
    "langflow": {
      "description": "Visual AI workflow orchestration and fraud detection pipeline design",
      "flow_file": "langflow/fraud_detection_flow.json",
      "docs": "https://www.ibm.com/products/watson-studio"
    },
    "orchestrate": {
      "description": "Intelligent agent automation and task orchestration across the pipeline",
      "docs": "https://www.ibm.com/products/watson-orchestrate"
    },
    "granite": {
      "model": "ibm/granite-13b-instruct-v2",
      "description": "Natural language generation for explainable AI fraud reports",
      "docs": "https://www.ibm.com/granite"
    }
  },
  "deployment": {
    "platform": "IBM Cloud",
    "runtime": "Python 3.10",
    "memory_mb": 512,
    "disk_mb": 1024,
    "instances": 1,
    "buildpacks": [
      "python"
    ],
    "health_check_path": "/health",
    "health_check_timeout": 30
  },
  "dependencies": {
    "python": ">=3.10",
    "packages": {
      "ibm-watson": ">=8.0.0",
      "langchain": ">=0.1.0",
      "scikit-learn": ">=1.3.0",
      "tensorflow": ">=2.13.0",
      "pandas": ">=2.0.0",
      "numpy": ">=1.24.0",
      "matplotlib": ">=3.7.0",
      "seaborn": ">=0.12.0",
      "flask": ">=3.0.0",
      "python-dotenv": ">=1.0.0",
      "pytest": ">=7.4.0"
    }
  },
  "project": {
    "type": "hackathon",
    "event": "IBM AI Innovation Challenge 2025",
    "track": "AI for Sustainability & Infrastructure",
    "submission_date": "2025-01-15",
    "demo_url": "taskflow/index.html",
    "presentation_url": "docs/presentation.pdf",
    "video_url": "https://your-demo-video-url.com"
  }
}
